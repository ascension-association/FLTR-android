<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only; everything inside is drawn by Compose (ui/theme). -->
    <style name="Theme.Fltr" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Fltr.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/sky_soft</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Fltr</item>
    </style>
</resources>
